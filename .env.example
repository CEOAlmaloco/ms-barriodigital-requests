# Oracle Autonomous Database (EP1-21)
# Copiá este archivo a .env y completá los valores. NUNCA subas .env ni el wallet a git.
#
# Ejemplo de URL (ajustá el alias al de tu tnsnames.ora: *_low / *_medium / *_high):
# ORACLE_URL=jdbc:oracle:thin:@barriodig_low?TNS_ADMIN=C:/Users/TU_USUARIO/oracle-wallets/barriodigital
#
# El alias (barriodig_low) debe coincidir exactamente con una entrada de tnsnames.ora del wallet.

ORACLE_URL=
ORACLE_USER=
ORACLE_PASSWORD=

# Carpeta local del wallet descomprimido (fuera del repo). Spring la usa como TNS_ADMIN.
# Ejemplo: C:/Users/TU_USUARIO/oracle-wallets/barriodigital
ORACLE_WALLET_DIR=
