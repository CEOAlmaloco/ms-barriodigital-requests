{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "request.citizen-comment v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "request.citizen-comment"
    },
    "schemaVersion": {
      "const": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "folio",
        "hasAttachment"
      ],
      "properties": {
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "folio": {
          "type": "string",
          "pattern": "^BD-\\d{4}-\\d{6}$"
        },
        "hasAttachment": {
          "type": "boolean"
        }
      }
    }
  },
  "unevaluatedProperties": false
}
